# Railway'de bunlar ortam degiskeni olarak girilir. .env ASLA commit edilmez.
DATABASE_URL="postgresql://user:pass@host:5432/graveborn?schema=public"

# Oturum jetonlarini imzalar. Uretimde MUTLAKA rastgele ve gizli olmali.
SESSION_SECRET="change-me"

PORT=4100
CORS_ORIGIN="https://graveborn.example"

# CLOUDFLARE TURNSTILE gizli anahtari.
# BOS BIRAKILIRSA bot kontrolu ATLANIR (gelistirme icin). Uretimde doldur —
# istemcinin "gecтim" demesi tek basina hicbir sey ifade etmez, jeton
# Cloudflare'a sorulur.
TURNSTILE_SECRET=""

# ADMIN PANELI. BOS BIRAKILIRSA tum /admin uclari 403 doner — yani
# doldurmamak GUVENLI taraf. Doldurulacaksa rastgele uretilmeli:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=""

# $GRAVE token mint adresi. HENUZ YOK — bos oldugu surece marketplace'in
# token bacagi 503 doner ve gold ilanlari calismaya devam eder.
TOKEN_MINT=""

# ── SOL ODEME RAYI ────────────────────────────────────────────────────
# ⚠️ IKISI BIRDEN dolmadan ray TAMAMEN KAPALI ve dugmeler hic cizilmiyor.
#
# Hazine adresi GIZLI DEGIL (alici adres, anahtar degil) ve acilista
# loglanip /sol/config ile yayinlaniyor — yanlissa GOZLE yakalansin diye.
TREASURY_ADDRESS=3STD6cr9TjgLPX28YU3KbeGMSnswtt3143eeYdL4hRD8

# Virgulle coklu ve SIRALI: ilki birincil, sonrakiler yedek.
#
# ⚠️ DUSEN UC 60 SANIYE ATLANIR ve sonra yeniden denenir (`rpc.ts`).
# GERCEK UCLARLA OLCULDU (2026-09-09): basa iki olu uc konup zincirden
# blockhash istendi → 1. istek 1072 ms (olulerin ustunden gecti),
# 2. istek 59 ms (oluler artik hic denenmiyor).
#
# OLCULEN UCRETSIZ UCLAR (2026-09-09, ucu de getLatestBlockhash VE
# getTransaction destekliyor):
#   ✅ https://solana-rpc.publicnode.com          ~286ms
#   ✅ https://api.mainnet-beta.solana.com        ~179ms (resmi, hiz sinirli)
#   ✅ https://solana.leorpc.com/?api_key=FREE    ~191ms
#   ❌ rpcpool 403 · omniatech HTML donuyor · ankr 403 · drpc 400
#   ❌ blockeden 402 · onfinality 429 · extrnode/metaplex/public-rpc olu
#   ❌ alchemy demo anahtari bozuk yanit
#
# ⚠️ UCRETSIZ UCLARLA CALISMAK BUGUN GUVENLI ve bu bir tahmin degil:
# bir satin alma ~2-4 RPC cagrisi ediyor (1 blockhash + 1 getTransaction,
# artı olası tekrar). Genel uclarin sinirlari bunun cok uzerinde. Asil risk
# HIZ SINIRI degil KESINTI, ve onu uc ucun yedeklemesi + odeme kurtarma
# (imza cihazda saklaniyor, "FINISH PAYMENT") karsiliyor.
# Ucretli bir saglayici (Helius vb.) gelirse BASA eklenir, bunlar yedek kalir.
RPC_URLS=https://solana-rpc.publicnode.com,https://api.mainnet-beta.solana.com,https://solana.leorpc.com/?api_key=FREE
