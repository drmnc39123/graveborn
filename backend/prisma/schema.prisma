// GRAVEBORN — sunucu-otoriteli ilerleme.
//
// TASARIM: istemci hiçbir zaman "şu kadar gold kazandım" DEMEZ. Sadece ne
// yaptığını bildirir (hangi derinliğe indim); ödülü sunucu KENDİ hesaplar,
// frontend'le AYNI saf fonksiyonu (progress.ts) çalıştırarak.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  /// Solana cüzdan adresi — kimlik budur
  wallet    String   @id
  createdAt DateTime @default(now())
  lastSeen  DateTime @updatedAt

  // ── Progress (frontend'deki Progress arayüzünün birebir karşılığı) ──
  gold          Int    @default(0)
  unlockedStage Int    @default(1)
  hero          String @default("knight")

  /// bölüm id → tamamlandı mı
  cleared    Json @default("{}")
  /// bölüm id → ilk-geçiş ödülü ödendi mi
  firstClear Json @default("{}")
  /// bölüm id → ödemesi yapılmış en derin seviye
  depthPaid  Json @default("{}")
  /// Forge yükseltmeleri: id → seviye
  upgrades   Json @default("{}")
  /// Pedlar's Stall'dan alınmış, koşuya taşınan tılsımlar (charms.ts id'leri)
  /// ⚠️ Koşu AÇILDIĞINDA tüketilir — koşuyu başlatıp çıkmak tılsımı kurtarmaz
  charms     Json @default("[]")

  /// The Reliquary'den çıkmış kozmetikler (cosmetics.ts id'leri)
  /// ⚠️ SADECE GÖRÜNÜR — hiçbiri stat/güç vermez. Gold'un sonsuz talebi bu
  /// koldan geliyor; güç satan ikinci bir sink P2W sarmalını ikiye katlardı.
  cosmetics    Json  @default("[]")
  /// yuva → takılı kozmetik id'si
  equipped     Json  @default("{}")
  /// tekrar çıkan kozmetiklerden biriken toz
  dust         Int   @default(0)
  /// anıt seviyesi — TAVANI YOK, ekonominin dipsiz kovası (bkz. ossuary.ts)
  ossuary      Int   @default(0)
  /// KURULMUŞ bahis (henüz yanmadı). Koşu AÇILIRKEN Run satırına taşınır.
  wager        Json?
  /// alınmış başarımlar (achievements.ts id'leri)
  achievements Json  @default("[]")

  /// Üyesi olduğu lonca (yoksa null). ⚠️ Bir oyuncu TEK loncada olabilir —
  /// alan Player'da tutuluyor, ayrı bir üyelik tablosu YOK. Ayrı tablo
  /// olsaydı "iki loncaya birden üye" durumu bir hataya bakardı; burada
  /// şemanın kendisi imkânsız kılıyor.
  guildId String?
  guild   Guild?  @relation(fields: [guildId], references: [id], onDelete: SetNull)

  /// Crypt Deed kademesi (0 = yok). ⚠️ Kasa payı BUNA göre ağırlıklanıyor.
  cryptTier        Int  @default(0)
  /// kasadan en son çekilen hafta — aynı hafta iki kez çekilemez
  cryptClaimedWeek Int  @default(0)
  /// günlük seri: { days, last }  — `last` SUNUCUNUN UTC günü
  streak           Json @default("{}")

  /// admin kararı — banlı oyuncu koşu başlatamaz
  banned Boolean @default(false)

  /// ⚠️ İYİMSER KİLİT SAYACI — her Progress yazımında BİR ARTAR.
  ///
  /// Olmadan her harcama bir oku-değiştir-yaz yarışıydı ve ÖLÇÜLDÜ: tam
  /// 1 çekilişlik gold'u (450) olan hesaba 5 eşzamanlı istek atınca 5'i de
  /// geçiyordu. `fromProgress` MUTLAK değer yazdığı için yazımlar birbirini
  /// eziyor; oyuncu ya bedavaya iş yaptırıyor ya da ödediği şeyi kaybediyor.
  ///
  /// Yazan taraf okuduğu `rev`'i şart koşar (`where: { wallet, rev }`);
  /// arada başka biri yazdıysa eşleşme olmaz, işlem 409 döner. Bkz.
  /// `saveProgress` (db.ts) — TÜM Progress yazımları oradan geçmeli.
  rev Int @default(0)

  // ── Leaderboard (denormalize) ──
  // ⚠️ `depthPaid` JSON'ından her istekte türetilebilirdi ama SIRALANAMAZ:
  // tüm oyuncuları belleğe çekip sıralamak oyuncu sayısıyla birlikte çöker.
  // Bu üç alan koşu kapanışında yazılır ve SADECE ARTAR.
  /// en zorlu temizlenen inişin bölümü
  bestStage  Int   @default(0)
  /// o inişteki derinlik
  bestDepth  Int   @default(0)
  /// challengeRating(bestStage, bestDepth) — sıralama bunun üzerinden
  bestRating Float @default(0)

  // ── Haftalık sezon (bkz. season.ts) ──
  // ⚠️ AYRI ALANLAR, `best*`'in kopyası değil. Sezon her Pazartesi sıfırlanır,
  // `best*` asla. İkisini tek alanda tutmaya çalışmak "rekorumu kaybettim"
  // şikâyetinin garantili yolu.
  //
  // ⚠️ SIFIRLAMA CRON İLE DEĞİL, TEMBEL: `seasonWeek` bu haftadan küçükse
  // puan geçen haftaya aittir ve yok sayılır. Böylece hafta dönüşünde
  // milyonlarca satır güncellemek gerekmiyor; oynamayan oyuncu zaten
  // tablodan kendiliğinden düşüyor.
  /// puanın ait olduğu hafta (bossWeek) — bu haftadan küçükse puan ölüdür
  seasonWeek   Int   @default(0)
  seasonStage  Int   @default(0)
  seasonDepth  Int   @default(0)
  seasonRating Float @default(0)

  runs     Run[]
  listings Listing[]
  awards   SeasonAward[]

  @@index([bestRating])
  @@index([guildId])
  @@index([seasonWeek, seasonRating])
}

// Bir koşu. POST /run/start ile AÇILIR, /run/finish ile KAPANIR.
//
// Neden kayıt tutuluyor:
//  1. SEED SUNUCUDAN gelir → "en kârlı seed'i bul" saldırısı biter
//  2. runId tek kullanımlık → aynı koşu iki kez ödül alamaz
//  3. koşunun modu/bölümü sunucuda saklanır → istemci kapanışta
//     "aslında 10. bölümdeydim" diyemez
model Run {
  id     String @id
  wallet String
  player Player @relation(fields: [wallet], references: [wallet], onDelete: Cascade)

  /// ⚠️ BigInt ŞART. seedFromString uint32 döndürüyor (0 … 4.294.967.295) ama
  /// Postgres Int (INT4) 2.147.483.647'de taşıyor — seed'lerin YARISI koşuyu
  /// 500 ile düşürüyordu. Aralıklı olduğu için üretimde teşhisi çok zor olurdu.
  seed       BigInt
  /// 'campaign' | 'descent'
  mode       String
  stageId    Int
  hero       String
  /// ⚠️ Descent'in başladığı derinlik (checkpoint). SUNUCU yazar, istemci
  /// seçemez: kapanışta süre tabanı buradan sayılıyor ve "d400'den başladım,
  /// d401'i geçtim" iddiası ancak burada tutulan gerçek değerle çürütülebilir.
  /// Eski koşularda 1 (varsayılan) zaten doğru değer.
  startDepth Int    @default(1)

  /// ⚠️ ASCENSION kademesi — SUNUCU yazar, istemci seçemez (bkz.
  /// `resolveAscension`). Kapanışta hem düşüş tavanı hem sıralama puanı
  /// buradan okunuyor; istemcinin gönderdiği kademeye bakılsaydı herkes
  /// 10. kademeyi iddia edip tabloyu kilitlerdi.
  ascension Int @default(0)

  /// ⚠️ Bahis koşu AÇILIRKEN buraya YAZILIR ve oyuncudan düşülür. Progress'te
  /// bırakılsaydı oyuncu koşu sırasında bahsi değiştirebilirdi.
  wagerStake  Int     @default(0)
  wagerTarget Int     @default(0)
  /// kapanışta: bahis kazanıldı mı (admin panelinde okunur)
  wagerWon    Boolean @default(false)

  startedAt DateTime  @default(now())
  claimedAt DateTime?

  /// kapanışta: istemcinin iddiası
  claimedDepth Int?
  claimedGold  Int?
  /// sunucunun verdiği
  awarded      Int?
  /// ⚠️ sunucunun KABUL ETTİĞİ derinlik — `claimedDepth` ham iddia, bu ise
  /// kırpma sonrası. Olmadan yanlış yazılmış bir leaderboard rekoru geri
  /// hesaplanamıyordu (bkz. leaderboard.recomputeAll).
  awardedDepth Int?
  /// sunucu iddiayı kırptıysa işaretlenir — admin panelinde şüpheli listesi
  capped       Boolean @default(false)

  @@index([wallet, startedAt])
}

// ── MARKETPLACE ───────────────────────────────────────────────────────
// Oyuncu GOLD'unu başka bir oyuncuya $GRAVE karşılığı satar.
//
// ⚠️ EV TAKASI DEĞİL. Hazine sabit kurdan gold almaz; token DAİMA başka bir
// oyuncunun cüzdanından gelir. Aksi hâlde oyun token BASMIŞ olur ve
// sıfır-emisyon sözü çöker.
//
// ⚠️ ESCROW ŞART. İlan açılırken gold oyuncunun bakiyesinden DÜŞÜLÜR ve
// burada tutulur. Düşülmezse oyuncu aynı gold'u hem satışa koyar hem
// Forge'da harcar — yoktan gold üretmenin en kolay yolu budur.
model Listing {
  id     String @id
  seller String
  player Player @relation(fields: [seller], references: [wallet], onDelete: Cascade)

  /// escrow'da tutulan gold (satıcının bakiyesinden düşülmüş)
  goldAmount Int
  /// istenen $GRAVE — en küçük birimde (tam sayı), kayan nokta ASLA kullanılmaz
  priceGrave BigInt

  /// 'active' | 'sold' | 'cancelled'
  status String @default("active")

  createdAt  DateTime  @default(now())
  closedAt   DateTime?
  /// satıldıysa alıcının cüzdanı
  buyer      String?
  /// ödemenin zincir üstü imzası — tek kullanımlık, tekrar kullanılamaz
  paymentSig String?   @unique

  @@index([status, createdAt])
  @@index([seller, status])
}

// ── GOLD DEFTERİ ──────────────────────────────────────────────────────
// Her gold hareketinin kaydı. Bugüne kadar HİÇ tutulmuyordu: bakiye
// değişiyordu ama nereye gittiği kaybolyordu.
//
// İki soruyu birden cevaplıyor:
//   • oyuncu:  "gold'um nereye gitti"
//   • yönetim: "musluk mu sink mi ağır basıyor, ekonomi sızdırıyor mu"
//
// ⚠️ KAYIT, BAKİYE DEĞİŞİMİYLE AYNI TRANSACTION'DA yazılmalı. Ayrı yazılırsa
// biri başarısız olduğunda defter yalan söyler — ve yalan söyleyen bir defter
// hiç defter tutmamaktan kötüdür, çünkü ona bakıp karar verilir.
model Ledger {
  id     String   @id
  wallet String
  at     DateTime @default(now())

  /// nereye/nereden: 'run' | 'forge' | 'charm' | 'reliquary' | 'dust' |
  /// 'ossuary' | 'wager' | 'market_list' | 'market_cancel'
  kind   String
  /// gold değişimi — POZİTİF kazanç (musluk), NEGATİF harcama (sink)
  gold   Int
  /// serbest ayrıntı: yükseltme id'si, kozmetik id'si, derinlik…
  detail String?

  @@index([wallet, at])
  @@index([kind, at])
}

// ── HAFTALIK ORTAK BOSS ───────────────────────────────────────────────
// Herkesin AYNI düşmana vurduğu tek yer. Can havuzu burada tutuluyor;
// istemcinin "canı şu kadar kaldı" demesi mümkün değil.
model WorldBoss {
  /// UTC Pazartesi başlangıçlı hafta numarası — kimlik budur
  week   Int    @id
  bossId String
  /// kalan ortak can (0 = devrildi)
  hp     Int
  maxHp  Int

  createdAt DateTime @default(now())
}

// Bir oyuncunun o haftaki toplam katkısı.
// ⚠️ Hasar TOPLANIR (increment) — her koşu bir öncekinin üstüne biner.
model BossDamage {
  id     String @id
  week   Int
  wallet String
  damage Int    @default(0)
  /// kaç koşuda vurdu — admin için "insan hızı" sinyali
  runs   Int    @default(0)

  @@unique([week, wallet])
  @@index([week, damage])
}

// Cüzdan doğrulama için tek kullanımlık metin. İmzalanır, sonra silinir.
model AuthNonce {
  wallet    String   @id
  nonce     String
  expiresAt DateTime
}

// Kapanmış bir haftanın sonucu — sezon tablosunun defteri.
//
// ⚠️ TEK SATIR = TEK HAFTA (`@id`). Ödül dağıtımı bu satırın YARATILMASIYLA
// aynı transaction'da yapılıyor: satır zaten varsa dağıtım da yapılmıştır.
// Eşzamanlı iki istek aynı haftayı kapatmaya kalkarsa ikincisi birincil
// anahtara çarpar ve sessizce düşer — çift ödül imkânsız.
model SeasonClose {
  /// kapatılan hafta
  week      Int      @id
  settledAt DateTime @default(now())
  /// kaç oyuncu ödül aldı
  winners   Int      @default(0)
}

// Bir oyuncunun bir haftadan aldığı ödül. Oyuncuya "geçen hafta 3. oldun"
// diyebilmek için tutuluyor — yoksa ödül sessizce envantere düşerdi.
model SeasonAward {
  id        String   @id
  week      Int
  wallet    String
  rank      Int
  /// verilen kozmetik id'si (yoksa sadece toz verilmiştir)
  cosmetic  String?
  dust      Int      @default(0)
  createdAt DateTime @default(now())

  player Player @relation(fields: [wallet], references: [wallet], onDelete: Cascade)

  /// Bir oyuncu bir haftadan EN FAZLA BİR ödül alır — dağıtım tekrarlansa bile
  @@unique([week, wallet])
  @@index([wallet, week])
}

// CRYPT VAULT — deed sahiplerinin paylaştığı ortak kasa.
//
// ⚠️ TEK SATIR (`id` sabit 1). Kasa bir BAKİYE: her gold sink'inin %10'u
// buraya düşüyor, deed sahipleri buradan çekiyor. Yapısal garanti bu
// tablodadır — içine girmemiş gold çıkamaz. Yani oyun yeni gold BASMIYOR,
// harcayandan deed sahibine AKTARIYOR.
//
// ⚠️ `filled`/`paid` sadece denetim için: `paid <= filled` HER ZAMAN doğru
// olmalı. Eşitsizlik bozulursa bir yerde gold basılmış demektir.
model CryptVault {
  id      Int @id @default(1)
  /// kasadaki çekilebilir bakiye
  balance Int @default(0)
  /// ömür boyu kasaya giren toplam (denetim)
  filled  Int @default(0)
  /// ömür boyu kasadan ödenen toplam (denetim) — ASLA filled'ı geçemez
  paid    Int @default(0)

  updatedAt DateTime @updatedAt
}

// LONCA — oyuncuyu oyuna değil BİRBİRİNE bağlayan katman (bkz. game/guild.ts).
//
// ⚠️ HAZİNE BİR SİNK, CÜZDAN DEĞİL. `treasury` yalnızca seviye satın almak
// için harcanır ve GERİ ÇEKİLEMEZ. Çekilebilseydi lonca, oyuncular arası
// gold transferi için bir kanal olurdu: kur, doldur, dağıt, kapat.
//
// ⚠️ Perk GOLD DEĞİL XP veriyor (bkz. GUILD_LEVELS). Gold veren bir lonca
// perki musluğu üye sayısıyla çarpardı.
model Guild {
  id       String @id
  name     String
  /// [ETİKET] — sohbette ve tabloda adın yanında
  tag      String @unique
  /// kurucunun cüzdanı. Devir YOK: kurucu ayrılırsa lonca dağılır.
  owner    String
  level    Int    @default(1)
  /// seviye almak için biriken gold (harcanınca düşer)
  treasury Int    @default(0)
  /// ömür boyu bağış — denetim için
  donated  Int    @default(0)

  /// ⚠️ ÜYE SAYACI — türetilebilir ama TÜRETİLEMEZ.
  /// `count(members)` okuyup sonra yazmak Postgres'in varsayılan READ
  /// COMMITTED izolasyonunda YARIŞ AÇAR: iki istek aynı anda 4 okur, ikisi
  /// de tavanı geçmediğini sanır, üye 6 olur. ÖLÇÜLDÜ — 5 kişilik loncaya
  /// 8 eşzamanlı istekten 6'sı girdi.
  /// Sayaç satırda olunca `where: { memberCount: { lt: cap } }` ile TEK
  /// SATIRLIK koşullu yazma yapılabiliyor; o atomik.
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())

  members Player[]

  @@index([level])
}
